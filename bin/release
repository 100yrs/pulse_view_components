#!/usr/bin/env bash

set -e

VERSION=$1

if [ -z "$VERSION" ] ; then
  echo "Please provide version number: bin/release 1.0.0" && exit 1;
fi

if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ; then
  echo "Version must be MAJOR.MINOR.PATCH, e.g. 1.0.0" && exit 1;
fi

# gem push needs a RubyGems one-time code typed at a prompt. Fail before
# changing anything rather than after the commit is made.
if ! [ -t 0 ] ; then
  echo "bin/release prompts for a RubyGems one-time code, so run it in a terminal" && exit 1;
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$VERSION"
# Normalise so a zero-padded segment is not read as an octal Ruby literal
MAJOR=$((10#$MAJOR)); MINOR=$((10#$MINOR)); PATCH=$((10#$PATCH))
# Keep the tag, commit message and gem filename in step with the normalised form
VERSION="$MAJOR.$MINOR.$PATCH"

cat > ./lib/pulse/view_components/version.rb <<RUBY
# frozen_string_literal: true

# simplecov:disable
module Pulse
  module ViewComponents
    module VERSION
      MAJOR = $MAJOR
      MINOR = $MINOR
      PATCH = $PATCH

      STRING = [MAJOR, MINOR, PATCH].join('.')
    end
  end
end

# rubocop:disable-next Rails/Output
puts Pulse::ViewComponents::VERSION::STRING if __FILE__ == \$PROGRAM_NAME
RUBY

# Bundler 4 prints help for a bare `bundle`, so the subcommand is required or
# the lockfiles never pick up the new version
bundle install
cd demo
bundle install
cd ..
git add CHANGELOG.md Gemfile.lock demo/Gemfile.lock lib/pulse/view_components/version.rb
git commit -m "Bump version for $VERSION"
gem build pulse_view_components.gemspec

# Ask for the code just before pushing, since codes expire after 30 seconds.
# Publish the gem before pushing to git, so a failed push leaves only a local
# commit to retry from.
ATTEMPTS=0
until
  read -r -p "RubyGems one-time code: " OTP
  gem push "pulse_view_components-$VERSION.gem" --otp "$OTP"
do
  ATTEMPTS=$((ATTEMPTS + 1))
  if [ "$ATTEMPTS" -ge 3 ] ; then
    echo "gem push failed 3 times. The version commit is local and not pushed." && exit 1;
  fi
done
rm "pulse_view_components-$VERSION.gem"

git push
git tag v$VERSION
git push --tags

# A pushed tag does not create a GitHub release on its own, so make one here
# using this version's CHANGELOG section as the notes
if command -v gh > /dev/null 2>&1 ; then
  NOTES=$(awk -v ver="$VERSION" '
    $0 ~ "^## \\[" ver "\\]" { capture = 1; next }
    capture && /^## / { exit }
    capture && /^\[[^]]+\]:/ { exit }
    capture { print }
  ' CHANGELOG.md)

  if [ -n "$(printf '%s' "$NOTES" | tr -d '[:space:]')" ] ; then
    printf '%s\n' "$NOTES" | gh release create "v$VERSION" --title "v$VERSION" --notes-file -
  else
    echo "No CHANGELOG.md section for $VERSION, generating notes from commits"
    gh release create "v$VERSION" --title "v$VERSION" --generate-notes
  fi
else
  echo "gh CLI not found. Create the release manually for tag v$VERSION"
fi

# echo "Need to publish NPM package too?"

